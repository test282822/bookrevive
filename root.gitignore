# ========================
# BookRevive — Root .gitignore
# ========================

# NEVER commit real keys or env files
.env
.env.local
.env*.local

# Python
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
env/
*.egg-info/
dist/
build/

# Output files — never commit generated EPUBs
output/
*.epub
*.md.bak

# Next.js
.next/
out/

# Node
node_modules/
npm-debug.log*

# OS
.DS_Store
Thumbs.db
desktop.ini

# Editor
.vscode/
.idea/
*.swp
*.swo
